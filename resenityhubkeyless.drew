-- Serenity Hub - Key System (Modern Black & Pink Theme + Auto Save 24h)
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")

-- Tên file để lưu trạng thái key (Lưu trong workspace của executor)
local FileName = "SerenityHub_KeyData.json"

-- Hàm kiểm tra file hỗ trợ lưu key (nếu executor có hỗ trợ writefile/readfile)
local function isKeyValid()
    if not (writefile and readfile and isfile and HttpService) then return false end
    
    pcall(function()
        if isfile(FileName) then
            local data = game:GetService("HttpService"):JSONDecode(readfile(FileName))
            -- Kiểm tra xem thời gian lưu có trong vòng 24 giờ (86400 giây) hay không
            if data and data.Key == "SerenityHubKeyHsiwjAlwieheooehVsiwoenslbdoHsowpaljs" then
                if os.time() - data.Time < 86400 then
                    return true
                end
            end
        end
    end)
    return false
end

local function saveKey()
    if writefile and HttpService then
        pcall(function()
            local data = {
                Key = "SerenityHubKeyHsiwjAlwieheooehVsiwoenslbdoHsowpaljs",
                Time = os.time()
            }
            writefile(FileName, HttpService:JSONEncode(data))
        end)
    end
end

-- Nếu key đã được lưu và hợp lệ trong 24h, tự động vào Hub luôn mà không hiện bảng Key
if isKeyValid() then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/MUshihara/Serenity-hub/main/loader.lua"))()
    return
end

-- Xóa UI cũ nếu tồn tại
if CoreGui:FindFirstChild("SerenityKeySystem") then
    CoreGui.SerenityKeySystem:Destroy()
end

